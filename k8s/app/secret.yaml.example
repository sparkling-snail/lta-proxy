# Copy to secret.yaml, fill in your LTA_API_KEY, then apply.
# secret.yaml is gitignored — never commit it.
#
# Apply with: kubectl apply -f k8s/app/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: lta-proxy-secret
  namespace: lta-proxy
type: Opaque
stringData:
  LTA_API_KEY: "paste-your-key-here"
